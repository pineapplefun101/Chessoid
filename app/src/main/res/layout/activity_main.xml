<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageButton
        android:id="@+id/btnBotMatch"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/bot_match_placeholder"
        app:layout_constraintBottom_toTopOf="@+id/btnPuzzles"
        app:layout_constraintEnd_toStartOf="@+id/btnCoaching"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnCoaching"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/coach_placeholder"
        app:layout_constraintBottom_toTopOf="@+id/btnHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnBotMatch"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageButton
        android:id="@+id/btnPuzzles"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/puzzles_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBotMatch" />

    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/history_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnPuzzles"
        app:layout_constraintTop_toBottomOf="@+id/btnCoaching" />

</androidx.constraintlayout.widget.ConstraintLayout>